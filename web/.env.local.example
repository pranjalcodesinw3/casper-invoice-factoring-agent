# CSPR.click application id (register at https://console.cspr.click). Without it the
# wallet UI renders in an unconfigured state and no deploys can be signed.
NEXT_PUBLIC_CSPR_CLICK_APP_ID=

# Deployed ReceivableEscrow contract hash (from the deploy receipt), e.g. hash-09ab...
NEXT_PUBLIC_CONTRACT_HASH=

# Agent underwriting server base URL.
NEXT_PUBLIC_AGENT_URL=http://localhost:4030
