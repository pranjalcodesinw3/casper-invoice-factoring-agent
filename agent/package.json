{
  "name": "invoice-factoring-agent",
  "version": "0.1.0",
  "description": "Agentic underwriting backend for invoice factoring on Casper",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "provider": "tsx watch src/risk-provider.ts",
    "cli:good": "tsx src/cli.ts good",
    "cli:risky": "tsx src/cli.ts risky",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "e2e": "tsx src/e2e.ts good",
    "e2e:risky": "tsx src/e2e.ts risky"
  },
  "dependencies": {
    "express": "^4.18.2",
    "openai": "^6.45.0",
    "casper-js-sdk": "^5.0.12",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "tsx": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
